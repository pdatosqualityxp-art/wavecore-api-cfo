# Supabase project URL, for example https://your-project.supabase.co
SUPABASE_URL=

# Secret service_role key from the Supabase project settings
SUPABASE_SERVICE_ROLE_KEY=

# API key for Google Gemini
GEMINI_API_KEY=

# Gemini model for agent planning and responses
GEMINI_AGENT_MODEL=gemini-3.5-flash-lite

# Gemini model for document and query embeddings
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
